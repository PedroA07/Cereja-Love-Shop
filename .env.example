# ============================================================
# Cereja Love Shop — variáveis de ambiente (exemplo)
# Copie para .env e preencha. NUNCA commite segredos reais (§8).
# ============================================================

NODE_ENV=development

# --- API ---
API_PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Front (Next.js) ---
# Base da API usada pelo browser.
#  - Local: aponte direto para a API (mesmo site: localhost).
#  - Produção (Vercel): use o caminho relativo "/api/v1" e configure o proxy
#    abaixo, para o cookie de sessão ser first-party (loja e API em domínios
#    diferentes, ex.: vercel.app + onrender.com).
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# NEXT_PUBLIC_API_URL=/api/v1   # <- use este na Vercel

# Destino do proxy same-origin (só em produção/Vercel). Ex.: URL do Render.
# API_PROXY_TARGET=https://cereja-api-uilh.onrender.com

# Admin (staff): seed do primeiro administrador (usado por db:seed)
SEED_ADMIN_EMAIL=admin@cerejaloveshop.local
SEED_ADMIN_PASSWORD=troque-esta-senha

# --- PostgreSQL ---
# Requer extensões: citext, pgcrypto (habilitadas na migração inicial)
#
# Local (dev): as duas URLs apontam para o mesmo Postgres.
# Supabase (prod): DATABASE_URL = pooler (porta 6543, com ?pgbouncer=true);
#                  DIRECT_URL   = conexão direta (porta 5432), usada nas migrações.
#   DATABASE_URL="postgresql://postgres.PROJ:SENHA@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.PROJ:SENHA@aws-...pooler.supabase.com:5432/postgres"
DATABASE_URL=postgresql://cereja:cereja@localhost:5432/cereja?schema=public
DIRECT_URL=postgresql://cereja:cereja@localhost:5432/cereja?schema=public

# --- Redis (sessão / cache / filas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_meili_master_key_change_me

# --- Object storage (MinIO em dev, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cereja-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Auth / JWT ---
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Criptografia de coluna (PII: CPF, birth_date, telefone) — §1.2/§8 ---
# Chave AES-256-GCM em base64 (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COLUMN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# --- Pagamentos (§6.5) ---
# Adaptador do gateway: sandbox (padrão) | mercadopago | pagarme
PAYMENT_PROVIDER=sandbox
# Segredo para validar a assinatura HMAC dos webhooks do provedor
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-de-webhook
# Credenciais do provedor real (quando sair do sandbox):
# PAYMENT_API_KEY=
# PAYMENT_PUBLIC_KEY=   # usada no browser para tokenizar o cartão (SAQ-A)

# --- Discrição (§1.2 / §8) ---
# Descritor neutro que aparece na fatura do cartão e no remetente do pacote.
BILLING_STATEMENT_DESCRIPTOR=CLS*COMPRAS
DISCREET_SENDER_NAME=CLS Distribuidora
